{
  "buildCommand": "npm run db:migrate && next build",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "bilingualboost.online" }],
      "destination": "https://www.bilingualboost.online/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "bilingualboost.online" }],
      "destination": "https://www.bilingualboost.online/:path*",
      "permanent": true
    }
  ]
}
